QListView {
    background-color: #ffffff;
    border: 1px solid #2eaa6e;
    padding: 2px;
    color: #1a3d33;
    outline: none;
}

QListView::item {
    padding: 10px 14px;
    background-color: transparent;
    color: #1a3d33;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

QListView::item:hover {
    background-color: rgba(46, 170, 110, 0.15);
}

QListView::item:selected {
    background-color: rgba(46, 170, 110, 0.30);
    color: #1a3d33;
}
