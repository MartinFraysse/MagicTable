/* =======================================================================
   MAGIC TABLE — PLAYERS VIEW
   ======================================================================= */

/* =======================================================================
   MAIN VIEW
   ======================================================================= */

#PlayersViewMain {
    background-color: transparent;
}

#PlayersHeader {
    background-color: transparent;
}

/* =======================================================================
   SECTION TITLE
   ======================================================================= */

#SectionTitle {
    color: #eafff6;
    font-size: 20px;
    font-weight: bold;
}

#CountLabel {
    color: #7fd9bb;
    font-size: 14px;
    font-weight: 600;
    padding-left: 8px;
}

/* =======================================================================
   PRIMARY BUTTON
   ======================================================================= */

#PrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #34cfa1, stop:1 #1f7a5a);
    color: #eafff7;
    border: 1px solid #55e0b6;
    border-radius: 10px;
    padding: 0 20px;
    min-height: 40px;
    min-width: 180px;
    font-size: 14px;
    font-weight: 700;
}

#PrimaryButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #55e0b6, stop:1 #2fb38a);
}

#PrimaryButton:pressed {
    background: #17664a;
}

/* =======================================================================
   SEARCH INPUT
   ======================================================================= */

#PlayersSearchInput {
    min-height: 32px;
    padding: 6px 12px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #132f26, stop:1 #0f241d);
    border: 1px solid #5fa693;
    border-radius: 8px;
    color: #eafff6;
    font-size: 13px;
    font-weight: 500;
}
#PlayersSearchInput::placeholder {
    color: #9fcab8;
}
#PlayersSearchInput:focus {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #153a2e, stop:1 #132f26);
    border-color: #7fd9bb;
}

/* =======================================================================
   PLAYERS TABLE
   ======================================================================= */

#PlayersTable {
    background-color: #0f241d;
    border: 1px solid #2f6f55;
    border-radius: 10px;
    gridline-color: transparent;
    outline: none;
    padding: 4px;
}

#PlayersTable QTableWidget,
#PlayersTable QWidget {
    background-color: #0f241d;
}

#PlayersTable::item {
    background-color: transparent;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    border: none;
}

#PlayersTable::item:hover {
    background-color: transparent;
}

#PlayersTable::item:selected {
    background-color: transparent;
    color: #ffffff;
}

/* Header */
#PlayersTable QHeaderView {
    background-color: #0f241d;
}

#PlayersTable QHeaderView::section {
    background-color: #0f241d;
    color: #7fd9bb;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid rgba(63, 210, 125, 0.25);
}

/* Corner widget (entre les headers) */
#PlayersTable QTableCornerButton::section {
    background-color: #0f241d;
    border: none;
}

/* Scrollbar */
#PlayersTable QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#PlayersTable QScrollBar::handle:vertical {
    background-color: rgba(120, 220, 180, 0.45);
    border-radius: 4px;
    min-height: 32px;
}

#PlayersTable QScrollBar::handle:vertical:hover {
    background-color: rgba(150, 240, 200, 0.75);
}

#PlayersTable QScrollBar::add-line:vertical,
#PlayersTable QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

#PlayersTable QScrollBar::add-page:vertical,
#PlayersTable QScrollBar::sub-page:vertical {
    background: none;
}

/* =======================================================================
   COMMANDER GRID
   ======================================================================= */

#CommanderGridScroll {
    background-color: transparent;
    border: none;
}

#CommanderGridContent {
    background-color: transparent;
}

#CommanderGridScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#CommanderGridScroll QScrollBar::handle:vertical {
    background-color: rgba(120, 220, 180, 0.45);
    border-radius: 4px;
    min-height: 32px;
}

#CommanderGridScroll QScrollBar::handle:vertical:hover {
    background-color: rgba(150, 240, 200, 0.75);
}

#CommanderGridScroll QScrollBar::add-line:vertical,
#CommanderGridScroll QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

#CommanderGridScroll QScrollBar::add-page:vertical,
#CommanderGridScroll QScrollBar::sub-page:vertical {
    background: none;
}

/* =======================================================================
   CREATE PLAYER DIALOG — IMAGE PICKER
   ======================================================================= */

#CreatePlayerDialog #ImageNameLabel {
    color: #8fcfb5;
    font-size: 12px;
    padding: 0 8px;
    background-color: #132f26;
    border: 1px solid #1f4d3a;
    border-radius: 6px;
}

#CreatePlayerDialog #ImagePickerButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2f4f46, stop:1 #1f352f);
    color: #d3e6df;
    border: 1px solid #5fa693;
    border-radius: 6px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 600;
}

#CreatePlayerDialog #ImagePickerButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3b6b5f, stop:1 #26443d);
}

#CreatePlayerDialog #ImageClearButton {
    background-color: rgba(231, 76, 60, 0.15);
    color: #e74c3c;
    border: 1px solid rgba(231, 76, 60, 0.4);
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
}

#CreatePlayerDialog #ImageClearButton:hover {
    background-color: rgba(231, 76, 60, 0.3);
}

/* =======================================================================
   SCRYFALL DROPDOWN (autocomplete)
   ======================================================================= */

#ScryfallDropdown {
    background-color: #0f241d;
    border: 1px solid #3ad68a;
    border-radius: 6px;
    outline: none;
}

#ScryfallDropdown::item {
    color: #eafff6;
    font-size: 13px;
    padding: 5px 10px;
    border-radius: 4px;
}

#ScryfallDropdown::item:hover,
#ScryfallDropdown::item:selected {
    background-color: rgba(58, 214, 138, 0.18);
    color: #ffffff;
}

/* =======================================================================
   CREATE PLAYER DIALOG
   ======================================================================= */

#CreatePlayerDialog {
    background-color: #0f241d;
    border: 1px solid #1f4d3a;
    border-radius: 14px;
}

#CreatePlayerDialog #DialogTitle {
    font-size: 18px;
    font-weight: bold;
    color: #e8fff4;
    padding-bottom: 4px;
}

#CreatePlayerDialog QLabel {
    color: #b6dcd0;
    font-size: 13px;
    font-weight: 500;
}

#CreatePlayerDialog #DialogInput {
    min-height: 38px;
    padding: 8px 12px;
    background-color: #132f26;
    border: 1px solid #1f4d3a;
    border-radius: 10px;
    color: #eafff6;
    font-size: 14px;
}

#CreatePlayerDialog #DialogInput:focus {
    border-color: #3ad68a;
    background-color: #153a2e;
}

#CreatePlayerDialog #DialogInput[error="true"] {
    border-color: #e74c3c;
    background-color: rgba(231, 76, 60, 0.1);
}

#CreatePlayerDialog #ErrorLabel {
    color: #e74c3c;
    font-size: 12px;
    font-weight: 500;
    padding-top: 2px;
}

#CreatePlayerDialog #CancelButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2f4f46, stop:1 #1f352f);
    color: #d3e6df;
    border: 1px solid #5fa693;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 600;
}

#CreatePlayerDialog #CancelButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3b6b5f, stop:1 #26443d);
}

#CreatePlayerDialog #PrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #34cfa1, stop:1 #1f7a5a);
    color: #eafff7;
    border: 1px solid #55e0b6;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 700;
}

#CreatePlayerDialog #PrimaryButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #55e0b6, stop:1 #2fb38a);
}

#CreatePlayerDialog #PrimaryButton:pressed {
    background: #17664a;
}

/* =======================================================================
   PLAYER STATS DIALOG
   ======================================================================= */

#PlayerStatsDialog {
    background-color: #0f241d;
    border: 1px solid #1f4d3a;
    border-radius: 16px;
}

#PlayerStatsDialog #DialogTitle {
    font-size: 22px;
    font-weight: bold;
    color: #e8fff4;
}

#PlayerStatsDialog #DialogSubtitle {
    color: #8fcfb5;
    font-size: 14px;
    padding-bottom: 8px;
}

#PlayerStatsDialog #CancelButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2f4f46, stop:1 #1f352f);
    color: #d3e6df;
    border: 1px solid #5fa693;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 600;
}

#PlayerStatsDialog #CancelButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3b6b5f, stop:1 #26443d);
}

/* Stats Section */
#StatsSection {
    background-color: #132f26;
    border: 1px solid #2f6f55;
    border-radius: 12px;
    padding: 16px;
}

#StatsSectionTitle {
    color: #7fd9bb;
    font-size: 14px;
    font-weight: 600;
    padding-bottom: 8px;
}

/* Podium Cards */
#PodiumCard {
    background-color: #1a3d32;
    border: 1px solid #2f6f55;
    border-radius: 10px;
    padding: 12px 16px;
    min-width: 80px;
}

#PodiumCard:hover {
    border-color: #3ad68a;
}

#PodiumEmoji {
    font-size: 28px;
}

#PodiumCount {
    color: #eafff6;
    font-size: 24px;
    font-weight: bold;
}

#PodiumLabel {
    color: #8fcfb5;
    font-size: 11px;
}

/* Stats Total */
#StatsTotalLabel {
    color: #b6dcd0;
    font-size: 14px;
    font-weight: 500;
}

#StatsTotalValue {
    color: #3ad68a;
    font-size: 18px;
    font-weight: bold;
}

/* Stats Grid */
#StatsLabel {
    color: #8fcfb5;
    font-size: 13px;
}

#StatsValue {
    color: #eafff6;
    font-size: 14px;
    font-weight: 500;
}

/* Scroll area dans le dialog stats joueur */
#PlayerStatsDialog QScrollArea {
    background-color: #0f241d;
    border: none;
}

#PlayerStatsDialog QScrollArea QWidget {
    background-color: #0f241d;
}

#PlayerStatsDialog QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#PlayerStatsDialog QScrollBar::handle:vertical {
    background-color: rgba(120, 220, 180, 0.45);
    border-radius: 4px;
    min-height: 24px;
}

#PlayerStatsDialog QScrollBar::handle:vertical:hover {
    background-color: rgba(58, 214, 138, 0.7);
}

#PlayerStatsDialog QScrollBar::add-line:vertical,
#PlayerStatsDialog QScrollBar::sub-line:vertical {
    height: 0;
}

#PlayerStatsDialog QScrollBar::add-page:vertical,
#PlayerStatsDialog QScrollBar::sub-page:vertical {
    background: none;
}

/* Table commandants dans le dialog stats joueur */
#PlayerStatsDialog #MatchupsTable {
    background-color: #0f241d;
    border: none;
    border-radius: 0;
}

#PlayerStatsDialog #MatchupsTable::item {
    color: #eafff6;
    padding: 6px 8px;
    background-color: transparent;
}

#PlayerStatsDialog #MatchupsTable QHeaderView::section {
    background-color: #132f26;
    color: #7fd9bb;
    font-size: 12px;
    font-weight: 600;
    border: none;
    padding: 6px 8px;
}

/* ── Onglets statistiques commandant ─────────────────────────────────── */
#PlayerStatsDialog #StatsTabWidget {
    background-color: transparent;
    border: none;
}

#PlayerStatsDialog #StatsTabWidget::pane {
    background-color: #0f241d;
    border: 1px solid #2f6f55;
    border-radius: 10px;
    border-top-left-radius: 0px;
    top: -1px;
}

#PlayerStatsDialog #StatsTabWidget QTabBar {
    background: transparent;
}

#PlayerStatsDialog #StatsTabWidget QTabBar::tab {
    background-color: #0b1f18;
    color: #7a9e90;
    border: 1px solid #2f6f55;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 28px;
    font-size: 13px;
    font-weight: 600;
    margin-right: 3px;
    min-width: 90px;
}

/* Onglet Duel (1er) — accent rouge/or */
#PlayerStatsDialog #StatsTabWidget QTabBar::tab:first {
    border-top: 3px solid #0b1f18;
}

#PlayerStatsDialog #StatsTabWidget QTabBar::tab:first:selected {
    background-color: #0f241d;
    color: #e8880a;
    border-color: #2f6f55;
    border-top: 3px solid #e8880a;
    border-bottom: 1px solid #0f241d;
}

#PlayerStatsDialog #StatsTabWidget QTabBar::tab:first:hover:!selected {
    background-color: #1a2a1a;
    color: #e8880a;
    border-top: 3px solid #7a4400;
}

/* Onglet Multi (2ème) — accent vert */
#PlayerStatsDialog #StatsTabWidget QTabBar::tab:last {
    border-top: 3px solid #0b1f18;
}

#PlayerStatsDialog #StatsTabWidget QTabBar::tab:last:selected {
    background-color: #0f241d;
    color: #3fd27d;
    border-color: #2f6f55;
    border-top: 3px solid #3fd27d;
    border-bottom: 1px solid #0f241d;
}

#PlayerStatsDialog #StatsTabWidget QTabBar::tab:last:hover:!selected {
    background-color: #1a2a1a;
    color: #3fd27d;
    border-top: 3px solid #1f6b45;
}

#PlayerStatsDialog #StatsTabWidget QScrollArea {
    background-color: transparent;
    border: none;
}

#PlayerStatsDialog #StatsTabWidget QScrollArea QWidget {
    background-color: transparent;
}

/* ── Bouton filtre Duel ───────────────────────────────────────────────── */
#FilterToggleButton {
    background-color: transparent;
    color: #7a9a8a;
    border: 1px solid #3a5a4a;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
}
#FilterToggleButton:hover {
    border-color: #2d8a5e;
    color: #c8e8d8;
}
#FilterToggleButton:checked {
    background-color: #1a3d2e;
    color: #3fd27d;
    border-color: #3fd27d;
    font-weight: 600;
}

/* ── Bouton Matchup ───────────────────────────────────────────────────── */
#PlayerStatsDialog #MatchupButton {
    background-color: #1a2e1a;
    color: #e8880a;
    border: 1px solid #e8880a;
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 600;
}

#PlayerStatsDialog #MatchupButton:hover {
    background-color: #2a3e1a;
    border-color: #f4a030;
    color: #f4a030;
}

#PlayerStatsDialog #MatchupButton:pressed {
    background-color: #0f1f0f;
}

/* ── Stats Globales ───────────────────────────────────────────────────── */
#GlobalStatsScroll {
    background: transparent;
    border: none;
}

#GlobalStatsContainer {
    background: transparent;
}

#RankingRow {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    border: 1px solid rgba(63, 210, 125, 0.08);
}

#RankingRow:hover {
    background: rgba(63, 210, 125, 0.08);
    border: 1px solid rgba(63, 210, 125, 0.18);
}

#RankingNumber {
    color: #7ab89a;
    font-size: 13px;
    font-weight: bold;
}

/* ── Dialog Matchups (grille de cartes) ───────────────────────────────── */
#MatchupScroll {
    background: transparent;
    border: none;
}

#MatchupContainer {
    background: transparent;
}

#MatchupCard {
    border-radius: 12px;
    background: transparent;
}
