/* =====================
   DASHBOARD – TILES (LIGHT)
===================== */

#DashboardTile {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #f0faf7
    );
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
}

#DashboardTile:hover {
    border: 1px solid rgba(46, 170, 110, 0.6);
}

#DashboardTileIcon {
    font-size: 20px;
    color: #2d8a5e;
}

#DashboardTileValue {
    font-size: 24px;
    font-weight: 800;
    color: #1a3d33;
}

#DashboardTileTitle {
    font-size: 11px;
    letter-spacing: 1.4px;
    color: #5a8a7a;
    text-transform: uppercase;
}

/* =====================
   DASHBOARD – CARDS
===================== */

#DashboardCard {
    background-color: #ffffff;
    border-radius: 18px;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

/* Titres de sections */
#DashboardSectionTitle {
    color: #1a3d33;
    font-size: 16px;
    font-weight: 800;
}

/* =====================
   DASHBOARD – RANKING TABLE
===================== */

#DashboardTable {
    background-color: #ffffff;
    color: #1a3d33;
    font-size: 13px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
}

/* Viewport */
#DashboardTable QAbstractItemView::viewport {
    background-color: transparent;
}

/* Header */
#DashboardTable QHeaderView {
    background-color: transparent;
}

#DashboardTable QHeaderView::section {
    background-color: #e8f5f0;
    color: #2d5a4a;
    padding: 10px 8px;
    border: none;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

/* Lignes */
#DashboardTable::item {
    padding: 9px;
    background-color: transparent;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
}

/* Hover */
#DashboardTable::item:hover {
    background-color: rgba(46, 170, 110, 0.12);
}

/* Sélection */
#DashboardTable::item:selected {
    background-color: rgba(46, 170, 110, 0.25);
    color: #1a3d33;
}

/* Coins arrondis du header */
#DashboardTable QHeaderView::section:first {
    border-top-left-radius: 14px;
}

#DashboardTable QHeaderView::section:last {
    border-top-right-radius: 14px;
}

#DashboardTable QHeaderView::section {
    border-bottom: 1px solid rgba(0, 0, 0, 0.10);
}

/* =====================
   SCROLLBAR – RANKING TABLE
===================== */

#DashboardTable QScrollBar:vertical {
    background-color: rgba(0, 0, 0, 0.05);
    width: 10px;
    border-radius: 5px;
    margin: 4px 2px;
}

#DashboardTable QScrollBar::handle:vertical {
    background-color: rgba(46, 170, 110, 0.4);
    border-radius: 4px;
    min-height: 30px;
}

#DashboardTable QScrollBar::handle:vertical:hover {
    background-color: rgba(46, 170, 110, 0.6);
}

#DashboardTable QScrollBar::handle:vertical:pressed {
    background-color: rgba(46, 170, 110, 0.8);
}

#DashboardTable QScrollBar::add-line:vertical,
#DashboardTable QScrollBar::sub-line:vertical {
    height: 0px;
}

#DashboardTable QScrollBar::add-page:vertical,
#DashboardTable QScrollBar::sub-page:vertical {
    background: none;
}

/* =====================
   DASHBOARD – TABLES EN COURS
===================== */

#TablesScrollArea {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(240, 250, 247, 0.0),
        stop:0.5 rgba(232, 245, 240, 0.8),
        stop:1 rgba(240, 250, 247, 0.0)
    );
    border-radius: 18px;
    padding: 2px 0;
}

#TablesScrollArea QAbstractScrollArea::viewport {
    background-color: transparent;
}

#TablesScrollContent {
    background-color: transparent;
}

/* =====================
   DASHBOARD – TABLE CARDS
===================== */

#TableCard {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #f5fcfa
    );
    border-radius: 16px;
    padding: 14px;
    border: 1px solid rgba(0, 0, 0, 0.10);
}

#TableCard:hover {
    border: 1px solid rgba(46, 170, 110, 0.6);
}

#TableCardTitle {
    font-size: 14px;
    font-weight: 800;
    color: #1a3d33;
}

#TableCardPlayers {
    font-size: 13px;
    color: #3d6b5e;
}

#TableCardRunning {
    color: #b8860b;
    font-weight: 600;
}

#TableCardFinished {
    color: #2d8a5e;
    font-weight: 600;
}

#TableCardWinner {
    color: #1e8f55;
    font-weight: 700;
}

/* =====================
   DASHBOARD – PLAYER MATCHES POPUP
===================== */

#PlayerMatchesPopup {
    background-color: #ffffff;
    border: 1px solid #2eaa6e;
    border-radius: 3px;
}

#PopupTitle {
    font-weight: bold;
    color: #1e8f55;
}

#PopupContent {
    color: #3d6b5e;
    font-size: 12px;
}

/* =====================
   Dashboard tile accent
===================== */

QFrame#DashboardTileAccent {
    background-color: #2eaa6e;
    border-radius: 2px;
}

/* =====================
   COMBOBOX – LIGHT THEME
===================== */

QComboBox#FormatComboBox {
    background-color: #ffffff;
    color: #1a3d33;
    border: 1px solid rgba(46, 170, 110, 0.55);
    border-radius: 10px;
    padding: 6px 36px 6px 12px;
    min-height: 42px;
    font-size: 13px;
}

QComboBox#FormatComboBox:hover {
    border-color: rgba(46, 170, 110, 0.85);
}

QComboBox#FormatComboBox:focus {
    border-color: #2eaa6e;
    background-color: #f5fcfa;
}

QComboBox#FormatComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border-left: 1px solid rgba(46, 170, 110, 0.35);
}

QComboBox#FormatComboBox::down-arrow {
    image: none;
}

QComboBox#FormatComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a3d33;
    border: 1px solid rgba(46, 170, 110, 0.6);
    border-radius: 10px;
    outline: 0;
    selection-background-color: #2eaa6e;
    selection-color: #ffffff;
}

QComboBox#FormatComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 42px;
    border-radius: 6px;
}

QComboBox#FormatComboBox QAbstractItemView::item:selected {
    background-color: #2eaa6e;
    color: #ffffff;
}

QComboBox#FormatComboBox:disabled {
    background-color: #f0f0f0;
    color: #999999;
    border-color: rgba(46, 170, 110, 0.25);
}

QPushButton#PrimaryButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #2eaa6e,
        stop:1 #1e8f55
    );
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 22px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
}

QPushButton#PrimaryButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #36c07a,
        stop:1 #28a366
    );
    border: 1px solid rgba(46, 170, 110, 0.7);
}

QPushButton#PrimaryButton:pressed {
    background: #1e8f55;
}

QPushButton#SecondaryButton {
    background-color: #ffffff;
    color: #3d6b5e;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.12);
}

QPushButton#SecondaryButton:hover {
    background-color: rgba(46, 170, 110, 0.12);
    border: 1px solid rgba(46, 170, 110, 0.5);
    color: #1a3d33;
}

QPushButton#SecondaryButton:disabled {
    background-color: #f5f5f5;
    color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(0, 0, 0, 0.08);
}

QPushButton#PrimaryButton:disabled {
    background: #e0e0e0;
    color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(0, 0, 0, 0.08);
}

QPushButton#PrimaryButton:disabled:hover {
    background: #e0e0e0;
}

/* =====================
   DANGER BUTTON (Reset)
===================== */

QPushButton#DangerButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #e74c3c,
        stop:1 #c0392b
    );
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

QPushButton#DangerButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #ff6b5b,
        stop:1 #e74c3c
    );
    border: 1px solid rgba(255, 100, 100, 0.6);
}

QPushButton#DangerButton:pressed {
    background: #c0392b;
}

/* =====================
   WARNING BUTTON (Round varié)
===================== */

QPushButton#WarningButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #f5a623,
        stop:1 #d4920d
    );
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

QPushButton#WarningButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #ffc04d,
        stop:1 #f5a623
    );
    border: 1px solid rgba(255, 200, 100, 0.7);
}

QPushButton#WarningButton:pressed {
    background: #d4920d;
}

QPushButton#WarningButton:disabled {
    background: #e0e0e0;
    color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(0, 0, 0, 0.08);
}

/* =====================
   REPETITION WARNING LABEL
===================== */

#RepetitionWarning {
    color: #d4920d;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 8px;
}

/* =====================
   ARCHIVE BUTTON
===================== */

QPushButton#ArchiveButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #5b9bd5,
        stop:1 #4a7fb8
    );
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

QPushButton#ArchiveButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #6db3f2,
        stop:1 #5b9bd5
    );
    border: 1px solid rgba(150, 200, 255, 0.6);
}

QPushButton#ArchiveButton:pressed {
    background: #4a7fb8;
}
