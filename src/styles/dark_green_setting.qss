/* =======================================================================
   MAGIC TABLE — SETTINGS VIEW
   ======================================================================= */

#SettingsView {
    background-color: transparent;
}

#SettingsScroll {
    background-color: transparent;
    border: none;
}

#SettingsScroll QWidget {
    background-color: transparent;
}

#SettingsScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#SettingsScroll QScrollBar::handle:vertical {
    background-color: rgba(120, 220, 180, 0.45);
    border-radius: 4px;
    min-height: 32px;
}

#SettingsScroll QScrollBar::handle:vertical:hover {
    background-color: rgba(150, 240, 200, 0.75);
}

#SettingsScroll QScrollBar::add-line:vertical,
#SettingsScroll QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

#SettingsScroll QScrollBar::add-page:vertical,
#SettingsScroll QScrollBar::sub-page:vertical {
    background: none;
}

/* =======================================================================
   TITLE
   ======================================================================= */

#SettingsTitle {
    color: #eafff6;
    font-size: 22px;
    font-weight: bold;
}

/* =======================================================================
   SECTIONS
   ======================================================================= */

#SettingsSection {
    background-color: #132f26;
    border: 1px solid #2f6f55;
    border-radius: 12px;
    padding: 16px;
}

#SettingsSectionTitle {
    color: #7fd9bb;
    font-size: 16px;
    font-weight: 600;
    padding-bottom: 4px;
}

#SettingsLabel {
    color: #b6dcd0;
    font-size: 14px;
}

#SettingsHint {
    color: #6b9d8a;
    font-size: 12px;
    font-style: italic;
}

/* =======================================================================
   SPINBOX
   ======================================================================= */

#SettingsSpinBox {
    background-color: #1a3d32;
    border: 1px solid #2f6f55;
    border-radius: 8px;
    color: #eafff6;
    font-size: 14px;
    padding: 8px 12px;
    min-height: 36px;
}

#SettingsSpinBox:focus {
    border-color: #3ad68a;
}

#SettingsSpinBox::up-button,
#SettingsSpinBox::down-button {
    width: 24px;
    background-color: #1c4a3a;
    border: 1px solid #2f6b56;
    border-radius: 4px;
}

#SettingsSpinBox::up-button:hover,
#SettingsSpinBox::down-button:hover {
    background-color: #256b52;
}

#SettingsSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #7fd9bb;
}

#SettingsSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #7fd9bb;
}

/* =======================================================================
   STATS
   ======================================================================= */

#SettingsStats {
    color: #8fcfb5;
    font-size: 13px;
    padding-right: 20px;
}

/* =======================================================================
   DANGER BUTTON
   ======================================================================= */

#DangerButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #c0392b, stop:1 #922b21);
    color: #fff5f5;
    border: 1px solid #e74c3c;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 38px;
    font-size: 13px;
    font-weight: 600;
}

#DangerButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #e74c3c, stop:1 #c0392b);
}

#DangerButton:pressed {
    background: #7b241c;
}

/* =======================================================================
   SCORING SECTION
   ======================================================================= */

#ScoringBlock {
    background-color: #0e2a20;
    border: 1px solid #1f5040;
    border-radius: 8px;
}

#ScoringFormatTitle {
    color: #3fd27d;
    font-size: 14px;
    font-weight: 700;
    padding-bottom: 2px;
}

#ScoringSubTitle {
    color: #7fd9bb;
    font-size: 13px;
    font-weight: 600;
    padding-top: 6px;
}

#ScoringLine {
    color: #9abfb2;
    font-size: 13px;
    font-family: monospace;
}

/* =======================================================================
   ABOUT SECTION
   ======================================================================= */

#SettingsAppName {
    color: #eafff6;
    font-size: 16px;
    font-weight: bold;
}

#SettingsVersion {
    color: #7fd9bb;
    font-size: 13px;
}

#SettingsDescription {
    color: #8fcfb5;
    font-size: 13px;
    line-height: 1.4;
}
