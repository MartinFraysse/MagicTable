/* =======================================================================
   MAGIC TABLE — PLAYERS VIEW (LIGHT)
   ======================================================================= */

#PlayersViewMain {
    background-color: transparent;
}

#PlayersHeader {
    background-color: transparent;
}

#SectionTitle {
    color: #1a3d33;
    font-size: 20px;
    font-weight: bold;
}

#CountLabel {
    color: #2d8a5e;
    font-size: 14px;
    font-weight: 600;
    padding-left: 8px;
}

#PrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2eaa6e, stop:1 #1e8f55);
    color: #ffffff;
    border: 1px solid #3bc87a;
    border-radius: 10px;
    padding: 0 20px;
    min-height: 40px;
    min-width: 180px;
    font-size: 14px;
    font-weight: 700;
}

#PrimaryButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3bc87a, stop:1 #2eaa6e);
}

#PrimaryButton:pressed {
    background: #1e8f55;
}

#PlayersSearchInput {
    min-height: 32px;
    padding: 6px 12px;
    background: #f5fcfa;
    border: 1px solid #90cdb5;
    border-radius: 8px;
    color: #1a3d33;
    font-size: 13px;
    font-weight: 500;
}
#PlayersSearchInput::placeholder {
    color: #7ab09a;
}
#PlayersSearchInput:focus {
    background: #eaf7f2;
    border-color: #2eaa6e;
}

#PlayersTable {
    background-color: #ffffff;
    border: 1px solid #c0e0d5;
    border-radius: 10px;
    gridline-color: transparent;
    outline: none;
    padding: 4px;
}

#PlayersTable QTableWidget,
#PlayersTable QWidget {
    background-color: #ffffff;
}

#PlayersTable::item {
    background-color: transparent;
    padding: 10px 14px;
    color: #1a3d33;
    font-size: 14px;
    font-weight: 500;
    border: none;
}

#PlayersTable::item:hover {
    background-color: transparent;
}

#PlayersTable::item:selected {
    background-color: transparent;
    color: #1a3d33;
}

#PlayersTable QHeaderView {
    background-color: #ffffff;
}

#PlayersTable QHeaderView::section {
    background-color: #f5fcfa;
    color: #2d8a5e;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid rgba(46, 170, 110, 0.25);
}

#PlayersTable QTableCornerButton::section {
    background-color: #ffffff;
    border: none;
}

#PlayersTable QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#PlayersTable QScrollBar::handle:vertical {
    background-color: rgba(46, 170, 110, 0.4);
    border-radius: 4px;
    min-height: 32px;
}

#PlayersTable QScrollBar::handle:vertical:hover {
    background-color: rgba(46, 170, 110, 0.6);
}

#PlayersTable QScrollBar::add-line:vertical,
#PlayersTable QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

#PlayersTable QScrollBar::add-page:vertical,
#PlayersTable QScrollBar::sub-page:vertical {
    background: none;
}

/* Scryfall dropdown */
#ScryfallDropdown {
    background-color: #ffffff;
    border: 1px solid #2eaa6e;
    border-radius: 6px;
    outline: none;
}

#ScryfallDropdown::item {
    color: #1a3d33;
    font-size: 13px;
    padding: 5px 10px;
    border-radius: 4px;
}

#ScryfallDropdown::item:hover,
#ScryfallDropdown::item:selected {
    background-color: rgba(46, 170, 110, 0.15);
    color: #1a3d33;
}

/* Commander Grid */
#CommanderGridScroll {
    background-color: transparent;
    border: none;
}

#CommanderGridContent {
    background-color: transparent;
}

#CommanderGridScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#CommanderGridScroll QScrollBar::handle:vertical {
    background-color: rgba(46, 170, 110, 0.4);
    border-radius: 4px;
    min-height: 32px;
}

#CommanderGridScroll QScrollBar::handle:vertical:hover {
    background-color: rgba(46, 170, 110, 0.7);
}

#CommanderGridScroll QScrollBar::add-line:vertical,
#CommanderGridScroll QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

#CommanderGridScroll QScrollBar::add-page:vertical,
#CommanderGridScroll QScrollBar::sub-page:vertical {
    background: none;
}

/* Image picker (light) */
#CreatePlayerDialog #ImageNameLabel {
    color: #2d6e52;
    font-size: 12px;
    padding: 0 8px;
    background-color: #f0faf5;
    border: 1px solid #90cdb5;
    border-radius: 6px;
}

#CreatePlayerDialog #ImagePickerButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #d6f0e6, stop:1 #bde0d0);
    color: #1a5e42;
    border: 1px solid #90cdb5;
    border-radius: 6px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 600;
}

#CreatePlayerDialog #ImagePickerButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #c0e8d5, stop:1 #a8d4be);
}

#CreatePlayerDialog #ImageClearButton {
    background-color: rgba(231, 76, 60, 0.1);
    color: #c0392b;
    border: 1px solid rgba(192, 57, 43, 0.4);
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
}

#CreatePlayerDialog #ImageClearButton:hover {
    background-color: rgba(231, 76, 60, 0.2);
}

/* Dialog styles */
#CreatePlayerDialog {
    background-color: #ffffff;
    border: 1px solid #c0e0d5;
    border-radius: 14px;
}

#CreatePlayerDialog #DialogTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1a3d33;
    padding-bottom: 4px;
}

#CreatePlayerDialog QLabel {
    color: #3d6b5e;
    font-size: 13px;
    font-weight: 500;
}

#CreatePlayerDialog #DialogInput {
    min-height: 38px;
    padding: 8px 12px;
    background-color: #f5fcfa;
    border: 1px solid #c0e0d5;
    border-radius: 10px;
    color: #1a3d33;
    font-size: 14px;
}

#CreatePlayerDialog #DialogInput:focus {
    border-color: #2eaa6e;
    background-color: #ffffff;
}

#CreatePlayerDialog #DialogInput[error="true"] {
    border-color: #e74c3c;
    background-color: rgba(231, 76, 60, 0.1);
}

#CreatePlayerDialog #ErrorLabel {
    color: #e74c3c;
    font-size: 12px;
    font-weight: 500;
    padding-top: 2px;
}

#CreatePlayerDialog #CancelButton {
    background: #ffffff;
    color: #3d6b5e;
    border: 1px solid #c0e0d5;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 600;
}

#CreatePlayerDialog #CancelButton:hover {
    background: #f5fcfa;
    border-color: #2eaa6e;
}

#CreatePlayerDialog #PrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2eaa6e, stop:1 #1e8f55);
    color: #ffffff;
    border: 1px solid #3bc87a;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 700;
}

#CreatePlayerDialog #PrimaryButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3bc87a, stop:1 #2eaa6e);
}

#CreatePlayerDialog #PrimaryButton:pressed {
    background: #1e8f55;
}

/* Player Stats Dialog */
#PlayerStatsDialog {
    background-color: #ffffff;
    border: 1px solid #c0e0d5;
    border-radius: 16px;
}

#PlayerStatsDialog #DialogTitle {
    font-size: 22px;
    font-weight: bold;
    color: #1a3d33;
}

#PlayerStatsDialog #DialogSubtitle {
    color: #5a8a7a;
    font-size: 14px;
    padding-bottom: 8px;
}

#PlayerStatsDialog #CancelButton {
    background: #ffffff;
    color: #3d6b5e;
    border: 1px solid #c0e0d5;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 600;
}

#PlayerStatsDialog #CancelButton:hover {
    background: #f5fcfa;
    border-color: #2eaa6e;
}

#StatsSection {
    background-color: #f5fcfa;
    border: 1px solid #c0e0d5;
    border-radius: 12px;
    padding: 16px;
}

#StatsSectionTitle {
    color: #2d8a5e;
    font-size: 14px;
    font-weight: 600;
    padding-bottom: 8px;
}

#PodiumCard {
    background-color: #ffffff;
    border: 1px solid #c0e0d5;
    border-radius: 10px;
    padding: 12px 16px;
    min-width: 80px;
}

#PodiumCard:hover {
    border-color: #2eaa6e;
}

#PodiumEmoji {
    font-size: 28px;
}

#PodiumCount {
    color: #1a3d33;
    font-size: 24px;
    font-weight: bold;
}

#PodiumLabel {
    color: #5a8a7a;
    font-size: 11px;
}

#StatsTotalLabel {
    color: #3d6b5e;
    font-size: 14px;
    font-weight: 500;
}

#StatsTotalValue {
    color: #1e8f55;
    font-size: 18px;
    font-weight: bold;
}

#StatsLabel {
    color: #5a8a7a;
    font-size: 13px;
}

#StatsValue {
    color: #1a3d33;
    font-size: 14px;
    font-weight: 500;
}

/* Scroll area dans le dialog stats joueur */
#PlayerStatsDialog QScrollArea {
    background-color: #ffffff;
    border: none;
}

#PlayerStatsDialog QScrollArea QWidget {
    background-color: #ffffff;
}

#PlayerStatsDialog QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#PlayerStatsDialog QScrollBar::handle:vertical {
    background-color: rgba(0, 120, 80, 0.3);
    border-radius: 4px;
    min-height: 24px;
}

#PlayerStatsDialog QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 150, 100, 0.5);
}

#PlayerStatsDialog QScrollBar::add-line:vertical,
#PlayerStatsDialog QScrollBar::sub-line:vertical {
    height: 0;
}

#PlayerStatsDialog QScrollBar::add-page:vertical,
#PlayerStatsDialog QScrollBar::sub-page:vertical {
    background: none;
}

/* Table commandants dans le dialog stats joueur */
#PlayerStatsDialog #MatchupsTable {
    background-color: #ffffff;
    border: none;
    border-radius: 0;
}

#PlayerStatsDialog #MatchupsTable::item {
    color: #1a3d33;
    padding: 6px 8px;
    background-color: transparent;
}

#PlayerStatsDialog #MatchupsTable QHeaderView::section {
    background-color: #f5fcfa;
    color: #2d8a5e;
    font-size: 12px;
    font-weight: 600;
    border: none;
    padding: 6px 8px;
}
