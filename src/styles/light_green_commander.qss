/* =======================================================================
   MAGIC TABLE — COMMANDERS VIEW (LIGHT)
   ======================================================================= */

#CommandersViewMain {
    background-color: transparent;
}

#CommandersHeader {
    background-color: transparent;
}

#CommandersScroll {
    background-color: transparent;
    border: none;
}

#CommandersContent {
    background-color: transparent;
}

#CommandersScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#CommandersScroll QScrollBar::handle:vertical {
    background-color: rgba(46, 170, 110, 0.4);
    border-radius: 4px;
    min-height: 32px;
}

#CommandersScroll QScrollBar::handle:vertical:hover {
    background-color: rgba(46, 170, 110, 0.65);
}

#CommandersScroll QScrollBar::add-line:vertical,
#CommandersScroll QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

/* =======================================================================
   COMMANDER CARD
   ======================================================================= */

#CommanderCard {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #ffffff, stop:1 #f0faf7);
    border: 1px solid #c0e0d5;
    border-left: 4px solid #c0e0d5;
    border-radius: 12px;
    min-height: 140px;
}

#CommanderCard:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #f5fffb, stop:1 #e8f5f0);
    border-color: rgba(46, 170, 110, 0.6);
    border-left-color: rgba(46, 170, 110, 0.6);
}

/* Accent gauche selon le format */
#CommanderCard[fmt="commander"] { border-left-color: #2eaa6e; }
#CommanderCard[fmt="duel"]      { border-left-color: #2d6ec0; }
#CommanderCard[fmt="both"]      { border-left-color: #8e44ad; }

#CommanderCard[fmt="commander"]:hover { border-left-color: #22c47e; }
#CommanderCard[fmt="duel"]:hover      { border-left-color: #4a8fe0; }
#CommanderCard[fmt="both"]:hover      { border-left-color: #a862cc; }

/* Nom */
#CommanderCardName {
    color: #1a3d33;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
}

/* =======================================================================
   MANA PIPS
   ======================================================================= */

#ManaPip_W {
    background-color: #e8e4cc;
    color: #333;
    border-radius: 12px;
    border: 1px solid #ccc;
    font-size: 10px;
    font-weight: 800;
}

#ManaPip_U {
    background-color: #2e6ec0;
    color: #fff;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 800;
}

#ManaPip_B {
    background-color: #2a2a3a;
    color: #ccc;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 800;
}

#ManaPip_R {
    background-color: #c0392b;
    color: #fff;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 800;
}

#ManaPip_G {
    background-color: #1e7a40;
    color: #fff;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 800;
}

#ManaPipNone {
    color: #8ab0a0;
    font-size: 12px;
    font-style: italic;
}

/* =======================================================================
   FORMAT BADGE
   ======================================================================= */

#CommanderFormatBadge {
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#CommanderFormatBadge[fmt="commander"] {
    background-color: rgba(46, 170, 110, 0.12);
    color: #1e8f55;
    border: 1px solid rgba(46, 170, 110, 0.3);
}

#CommanderFormatBadge[fmt="duel"] {
    background-color: rgba(45, 110, 192, 0.12);
    color: #2d6ec0;
    border: 1px solid rgba(45, 110, 192, 0.3);
}

#CommanderFormatBadge[fmt="both"] {
    background-color: rgba(142, 68, 173, 0.12);
    color: #8e44ad;
    border: 1px solid rgba(142, 68, 173, 0.3);
}

/* =======================================================================
   EMPTY STATE
   ======================================================================= */

#CommandersEmptyState {
    color: #8ab0a0;
    font-size: 15px;
    font-style: italic;
    padding: 60px 20px;
    qproperty-alignment: AlignCenter;
}

/* =======================================================================
   CREATE COMMANDER DIALOG
   ======================================================================= */

#CreateCommanderDialog {
    background-color: #ffffff;
    border: 1px solid #c0e0d5;
    border-radius: 14px;
}

#CreateCommanderDialog #DialogTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1a3d33;
    padding-bottom: 4px;
}

#CreateCommanderDialog QLabel {
    color: #3d6b5e;
    font-size: 13px;
    font-weight: 500;
}

#CreateCommanderDialog #DialogInput {
    min-height: 36px;
    padding: 8px 12px;
    background-color: #f5fcfa;
    border: 1px solid #c0e0d5;
    border-radius: 10px;
    color: #1a3d33;
    font-size: 14px;
}

#CreateCommanderDialog #DialogInput:focus {
    border-color: #2eaa6e;
    background-color: #edfaf4;
}

#CreateCommanderDialog #DialogInput[error="true"] {
    border-color: #e74c3c;
    background-color: rgba(231, 76, 60, 0.05);
}

#CreateCommanderDialog QComboBox {
    min-height: 36px;
    padding: 6px 12px;
    background-color: #f5fcfa;
    border: 1px solid #c0e0d5;
    border-radius: 10px;
    color: #1a3d33;
    font-size: 14px;
}

#CreateCommanderDialog QComboBox:focus {
    border-color: #2eaa6e;
}

#CreateCommanderDialog QComboBox::drop-down {
    border: none;
    width: 24px;
}

#CreateCommanderDialog QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #2d8a5e;
    margin-right: 8px;
}

#CreateCommanderDialog QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c0e0d5;
    color: #1a3d33;
    selection-background-color: #2eaa6e;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

#CreateCommanderDialog #ColorCheckBox {
    color: #1a3d33;
    font-size: 13px;
    spacing: 4px;
}

#CreateCommanderDialog #ColorCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c0e0d5;
    border-radius: 4px;
    background-color: #f5fcfa;
}

#CreateCommanderDialog #ColorCheckBox::indicator:checked {
    background-color: #2eaa6e;
    border-color: #1e8f55;
}

#CreateCommanderDialog #ErrorLabel {
    color: #e74c3c;
    font-size: 12px;
    font-weight: 500;
}

#CreateCommanderDialog #FormLabel {
    color: #3d6b5e;
    font-size: 13px;
    font-weight: 500;
}

#CreateCommanderDialog #CancelButton {
    background: #f0faf7;
    color: #3d6b5e;
    border: 1px solid #c0e0d5;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 600;
}

#CreateCommanderDialog #CancelButton:hover {
    background: #e0f0ea;
    border-color: #2eaa6e;
}

#CreateCommanderDialog #PrimaryButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2ecc85, stop:1 #1e8f55);
    color: #ffffff;
    border: 1px solid #1e8f55;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 36px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 700;
}

#CreateCommanderDialog #PrimaryButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3ad68a, stop:1 #2eaa6e);
}

#CreateCommanderDialog #PrimaryButton:pressed {
    background: #1a7a48;
}
